APP_NAME=Service Agreement Manager API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://sam:sam_dev_only@db:5432/service_agreements
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_DEFAULT_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_URL=http://localhost:3000/reset-password
AGREEMENT_PORTAL_URL=http://localhost:3000/agreement
AGREEMENT_PORTAL_TOKEN_MINUTES=10080
AGREEMENT_PORTAL_SEND_COOLDOWN_SECONDS=300
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
STORAGE_MAX_FILE_BYTES=26214400
WEBHOOK_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
NOTIFICATION_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
WEBHOOK_POLL_SECONDS=5
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_DEFAULT_MAX_ATTEMPTS=8
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM=
SMS_TIMEOUT_SECONDS=10
SMS_POLL_SECONDS=10
SMS_LEASE_SECONDS=60
SMS_DEFAULT_MAX_ATTEMPTS=5
BILLING_POLL_SECONDS=60
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Secure customer invoice payment links
INVOICE_PORTAL_URL=http://localhost:5173/invoice
INVOICE_PORTAL_TOKEN_MINUTES=10080
INVOICE_PORTAL_SEND_COOLDOWN_SECONDS=300
