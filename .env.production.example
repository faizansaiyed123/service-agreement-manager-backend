# Copy to .env.production and replace every placeholder before deployment.
APP_NAME=Service Agreement Manager API
APP_ENV=production
DEBUG=false
# Signup is allowed only after completing the email ownership verification link.
ALLOW_PUBLIC_REGISTRATION=true
API_V1_PREFIX=/api/v1
# docker-compose.production.yml replaces DATABASE_URL using POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://sam:CHANGE_ME_URL_SAFE_PASSWORD@db:5432/service_agreements
JWT_SECRET_KEY=replace-with-a-unique-random-jwt-secret-at-least-48-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=https://app.example.com
# Same-site policy for browser session cookies. Keep lax for the recommended same-origin deployment.
COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_DEFAULT_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_URL=https://app.example.com/reset-password
EMAIL_VERIFICATION_TOKEN_MINUTES=60
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_URL=https://app.example.com/verify-email
STORAGE_BACKEND=local
STORAGE_ROOT=/srv/app/storage
STORAGE_MAX_FILE_BYTES=26214400
WEBHOOK_ENCRYPTION_KEY=replace-with-a-unique-random-webhook-secret-at-least-32-characters
NOTIFICATION_ENCRYPTION_KEY=replace-with-a-separate-random-notification-secret-at-least-32-characters
WEBHOOK_POLL_SECONDS=5
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_DEFAULT_MAX_ATTEMPTS=8
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM=
SMS_TIMEOUT_SECONDS=10
SMS_POLL_SECONDS=10
SMS_LEASE_SECONDS=60
SMS_DEFAULT_MAX_ATTEMPTS=5
BILLING_POLL_SECONDS=60
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Compose-only variables. Use separate URL-safe alphanumeric random passwords (at least 32 characters).
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_REDIS_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
API_PORT=8000
